# Whisk & Layers Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Database Configuration
# Supported drivers: sqlite (default for zero-dependency local dev), mysql
DB_CLIENT=sqlite
DB_FILE=./data/whisk_layers.sqlite

# For MySQL production:
# DB_CLIENT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=whisk_layers

# Authentication & Security
JWT_SECRET=whisk_and_layers_super_secret_jwt_key_2026_artisan_cakes
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
